{
  "manifest_version": 3,
  "name": "StudyDock",
  "version": "1.5.0",
  "description": "Focused Udemy and Tutorials Dojo review, question notes, readable dark mode and private browser or desktop study exports.",
  "permissions": [
    "tabGroups",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.udemy.com/*",
    "http://127.0.0.1:8765/*",
    "https://portal.tutorialsdojo.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StudyDock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/course/*/learn/quiz/*",
        "https://*.udemy.com/course/*/learn/practice/*"
      ],
      "js": [
        "notes-store.js",
        "notes.js",
        "ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.udemy.com/*"
      ],
      "js": [
        "review.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.tutorialsdojo.com/courses/*"
      ],
      "js": [
        "review-content.js",
        "dojo.js",
        "review.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
